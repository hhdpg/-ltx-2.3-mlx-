# ===== LTX Studio 后端配置 =====
# 复制为 .env 后按本机实际路径修改；.env 已在 .gitignore 中

APP_NAME=LTX Local Studio
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

# 网页项目根目录（web-studio）
PROJECT_ROOT=~/AI/LTX23/web-studio

# 推理引擎项目与本机虚拟环境
LTX_PROJECT_ROOT=~/AI/LTX23/ltx-2-mlx
LTX_EXECUTABLE=~/AI/LTX23/ltx-2-mlx/.venv/bin/ltx-2-mlx
LTX_PYTHON=~/AI/LTX23/ltx-2-mlx/.venv/bin/python

# 模型：优先使用本地目录（不要填 Hugging Face 仓库 ID）
# 留空时会依次回退到「设置页保存的目录」→「HF 本地缓存（只读，不联网）」
LTX_MODEL_ID=dgrauet/ltx-2.3-mlx-q4
LTX_MODEL_PATH=
LTX_MODE=distilled
LTX_LOW_RAM=false

# 存储目录
UPLOAD_DIR=~/AI/LTX23/web-studio/uploads
OUTPUT_DIR=~/AI/LTX23/web-studio/output
LOG_DIR=~/AI/LTX23/web-studio/logs
DATABASE_URL=sqlite:///./data/studio.db

# 离线推理
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# 运行约束
MAX_UPLOAD_MB=15
MAX_PROMPT_LENGTH=4000
MAX_QUEUE_SIZE=10
GENERATION_TIMEOUT_SECONDS=7200

# I2V 图片条件参数（按本机 `ltx-2-mlx generate --help` 核对）
IMAGE_FRAME=0
IMAGE_STRENGTH=1.0
IMAGE_MODE=auto

# 本机 CLI（v0.18.0）已支持 --seed；若更换版本请重新核对
SEED_SUPPORTED=true

# 续写长度档位（extend_frames，新增帧 = 8 × N）
# 本机实测 1/2/4/8/12 均可完成；12 档峰值约 12 GB，为 24GB 机器保守上限
# ALLOWED_EXTEND_FRAMES 由代码内置，如需调整请改 app/core/config.py
